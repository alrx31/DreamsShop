{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=DB;Username=user;Password=password;Include Error Detail=true"
  },
  "Jwt": {
    "Key": "",
    "ExpiresInMinutes": 30,
    "RefreshTokenExpiresInDays" : 7 
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001",
        "Protocols": "Http1"
      },
      "Https": {
        "Url": "https://0.0.0.0:8081",
        "Protocols": "Http1AndHttp2",
        "Certificate": {
          "Path": "/app/https/dev-certificate.pfx",
          "Password": ""
        }
      }
    }
  }
}
